---
import Card from '../components/Card.astro'
import { METRICS } from '../data/site'

import bookIcon from '../icons/book.svg?raw'
import contact from '../icons/contact.svg?raw'
import graduation from '../icons/graduation.svg?raw'
---

<section class="py-12 lg:py-20 z-10 relative">
  <div class="container px-4 sm:px-6">
    <!-- max-w matches the content column used by Content.astro (max-w-6xl),
         so this row lines up with the About section below it. -->
    <ul
      class="grid grid-cols-1 sm:grid-cols-3 gap-6 lg:gap-8 max-w-6xl mx-auto"
    >
      <li class="h-full">
        <Card
          type="primary"
          icon={bookIcon}
          title="Publications"
          description={`${METRICS.publications} peer-reviewed papers in ecology and conservation, ${METRICS.leadAuthor} as lead author.`}
          href="/publications"
        />
      </li>

      <li class="h-full">
        <Card
          type="primary"
          icon={graduation}
          title="CV & Expertise"
          description="Education, fellowships, teaching, mentorship, and technical expertise."
          href="/skills-education"
        />
      </li>

      <li class="h-full">
        <Card
          type="primary"
          icon={contact}
          title="Outreach & contact"
          description="Science communication, community science, and how to reach me."
          href="/outreach"
        />
      </li>
    </ul>
  </div>
</section>
