---
import Content from '../layouts/Content.astro'
import Heading from '../components/Heading.astro'
import Article from '../components/Article.astro'
import {
  CV_PATH,
  CV_PDF_IS_CURRENT,
  SHOW_JOB_MARKET_NOTICE,
} from '../data/site'

const researchInterests = [
  'behavioural ecology and animal decision-making',
  'habitat selection across the life cycle',
  'movement ecology and animal tracking',
  'landscape connectivity and spatial conservation planning',
  'pollinator and avian conservation',
  'evidence synthesis for conservation decision-making',
]
---

<style>
  .content-section {
    margin-bottom: 3rem;
  }

  .content-section:last-child {
    margin-bottom: 0;
  }

  /* Modern image container with drop shadow */
  .image-container {
    max-width: 350px;
    margin: 1rem auto;
  }

  @media (min-width: 768px) {
    .image-container {
      max-width: 100%;
      margin: 0;
    }
  }

  .image-wrapper {
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.9) 0%,
      rgba(240, 253, 250, 0.95) 100%
    );
    padding: 0.75rem;
    border-radius: 1rem;
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.1),
      0 2px 4px -1px rgba(0, 0, 0, 0.06),
      0 20px 25px -5px rgba(0, 0, 0, 0.1);
    border: 1px solid rgba(var(--ac-primary), 0.1);
    transition: all 0.3s ease;
  }

  .image-wrapper:hover {
    transform: translateY(-4px);
    box-shadow:
      0 10px 15px -3px rgba(0, 0, 0, 0.1),
      0 4px 6px -2px rgba(0, 0, 0, 0.05),
      0 25px 50px -12px rgba(0, 0, 0, 0.15);
  }

  .image-wrapper img {
    border-radius: 0.75rem;
    width: 100%;
    height: 16rem;
    object-fit: cover;
  }

  @media (min-width: 768px) {
    .image-wrapper img {
      height: 20rem;
    }
  }

  /* Improved text readability */
  .content-text {
    font-size: 1rem;
    line-height: 1.75;
  }

  @media (min-width: 768px) {
    .content-text {
      font-size: 1.125rem;
      line-height: 1.8;
    }
  }

  @media (min-width: 1024px) {
    .content-text {
      font-size: 1.25rem;
    }
  }

  .interest-list {
    list-style-type: disc;
    padding-left: 1.5rem;
  }
</style>

<Content>
  <section>
    <Article>
      <Heading
        slot="header"
        level={1}
        gradient
        class="inline-block"
        text="About me"
        id="about-me"
      />

      <div class="overflow-hidden my-4">
        <!-- First Section: Research statement -->
        <div class="content-section">
          <div
            class="grid grid-cols-1 md:grid-cols-5 gap-6 lg:gap-8 items-center md:items-start"
          >
            <div class="md:col-span-3 order-2 md:order-1">
              <div class="content-text">
                <p class="mb-4">
                  I am a behavioural and conservation ecologist. Habitat loss
                  and environmental change are leading causes of biodiversity
                  loss, but species differ enormously in how they respond, and
                  those differences are hard to predict from habitat alone. My
                  research asks how animal behaviour, meaning what an animal
                  chooses, where it settles and how it moves, determines whether
                  a population persists, and how that knowledge becomes
                  conservation action that names specific places and measures.
                </p>

                <p class="mb-4">
                  I am currently a Postdoctoral Research Associate in the
                  Department of Biology and the Centre for Animals on the Move
                  at <a
                    href="https://www.uwo.ca/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link">Western University</a
                  >. Before that I held postdoctoral fellowships at the <a
                    href="https://www.uoguelph.ca/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link"
                    >University of Guelph</a
                  >, on the effects of environmental stressors on bumble bee
                  movement, and at <a
                    href="https://ok.ubc.ca/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link"
                    >UBC Okanagan</a
                  > with the BRAES Institute, on connectivity conservation in landscape
                  ecology. I have also worked as a Research Analyst in Ecosystem
                  and Climate Science at the <a
                    href="https://trca.ca/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link"
                    >Toronto and Region Conservation Authority</a
                  > and as a quantitative ecologist on landscape connectivity and
                  habitat suitability modelling. I completed my PhD, MSc, and BSc
                  at <a
                    href="https://www.yorku.ca/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link">York University</a
                  >.
                </p>

                <div>
                  <p class="mb-3 font-semibold text-neutral-700">
                    <strong>My research interests are:</strong>
                  </p>
                  <ul class="interest-list space-y-2">
                    {researchInterests.map((interest) => <li>{interest}</li>)}
                  </ul>
                </div>

                {
                  SHOW_JOB_MARKET_NOTICE && (
                    <div class="mt-6 p-4 bg-primary/5 rounded-xl border border-primary/10">
                      <p class="font-semibold text-neutral-700 mb-2">
                        On the faculty job market
                      </p>
                      <p class="text-neutral-600 mb-3">
                        I am seeking a tenure-track position where I can build
                        an independent research group in behavioural
                        conservation.
                      </p>
                      <div class="flex flex-wrap gap-3">
                        <a
                          href="/experience"
                          class="link"
                        >
                          Research
                        </a>
                        <span class="text-neutral-400">|</span>
                        <a
                          href={CV_PDF_IS_CURRENT ? CV_PATH : '/skills-education'}
                          class="link"
                        >
                          {CV_PDF_IS_CURRENT ? 'Download CV' : 'CV & expertise'}
                        </a>
                      </div>
                    </div>
                  )
                }
              </div>
            </div>

            <div class="md:col-span-2 order-1 md:order-2">
              <div class="image-container">
                <div class="image-wrapper">
                  <img
                    src="/pictures/AmandaLiczner.jpg"
                    alt="Amanda Liczner headshot in the field"
                    loading="lazy"
                  />
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Second Section: Bumble bees as a model organism -->
        <div class="content-section">
          <div
            class="grid grid-cols-1 md:grid-cols-5 gap-6 lg:gap-8 items-center md:items-start"
          >
            <div class="md:col-span-2 order-1">
              <div class="image-container">
                <div class="image-wrapper">
                  <img
                    src="/pictures/Bumble.jpg"
                    alt="Bumble bee with a radio tag on dandelions"
                    loading="lazy"
                  />
                </div>
              </div>
            </div>

            <div class="md:col-span-3 order-2">
              <div class="content-text">
                <p class="mb-4">
                  My research uses bumble bees as a model organism for
                  behavioural conservation questions, because their colony cycle
                  isolates decisions that matter. In spring a solitary queen
                  must find and secure a nest site, and that single choice
                  determines whether her colony succeeds over the months that
                  follow. Later in the cycle, workers must learn to handle
                  flowers, judge their quality, and navigate home; new queens
                  must find mates and secure a safe overwintering site. Each
                  stage is a different decision under different information,
                  which makes the system unusually well suited to testing how
                  behaviour translates into persistence. And because the habitat
                  selection dynamics of these pollinators are so poorly
                  understood, the answers matter directly for their
                  conservation.
                </p>

              </div>
            </div>
          </div>
        </div>

        <!-- Third Section: Across taxa and scales -->
        <div class="content-section">
          <div
            class="grid grid-cols-1 md:grid-cols-5 gap-6 lg:gap-8 items-center md:items-start"
          >
            <div class="md:col-span-2 order-1">
              <div class="image-container">
                <div class="image-wrapper">
                  <img
                    src="/pictures/Phoebe.jpg"
                    alt="Amanda Liczner with Phoebe in a kayak"
                    loading="lazy"
                  />
                </div>
              </div>
            </div>

            <div class="md:col-span-3 order-2">
              <div class="content-text">
                <p class="mb-4">
                  The same questions scale up, and I work across taxa to ask
                  them. I have modelled movement for migratory birds and bats as
                  well as bees, using the continental Motus Wildlife Tracking
                  System to identify priority areas for migration across the
                  Great Lakes region of northeastern North America. My bumble
                  bee telemetry work was the first of its kind, using an
                  expansive radio tower array to follow free-flying individuals,
                  and it sits at the opposite end of the scale. Between an insect
                  tracked over hundreds of metres and a bird tracked over
                  thousands of kilometres, the two bracket the scales at which
                  behaviour and movement limit population persistence. You can
                  read more on my
                  <a
                    href="/experience"
                    class="link"
                    >research page</a
                  >.
                </p>

                <p>
                  Away from the field and the data, I garden, hike, play violin,
                  bake, and spend time with my dog.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Article>
  </section>
</Content>
