---
const { href, label, class: className } = Astro.props
const normalise = (path: string) => path.replace(/\/+$/, '') || '/'
const currentPath = normalise(Astro.url.pathname)

const linkClasses = [
  'flex items-center gap-4 text-md hover:text-primary transition duration-300 ease-in-out [&.is-active]:text-primary [&.is-active]:font-medium pl-5 py-1 border-l border-neutral-200 hover:border-neutral-400 [&.is-active]:border-primary',
  className,
  normalise(href) === currentPath ? 'is-active' : '',
]
---

<li>
  <a class:list={[linkClasses]} href={href}>
    <span>{label}</span>
  </a>
</li>
