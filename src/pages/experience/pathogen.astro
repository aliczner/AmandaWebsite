---
import Content from '../../layouts/Content.astro'
import Heading from '../../components/Heading.astro'
import Article from '../../components/Article.astro'
import Layout from '../../layouts/Layout.astro'
import Sidebar from '../../layouts/Sidebar.astro'
import Header from '../../components/Header.astro'
import ProjectMeta from '../../components/ProjectMeta.astro'
import { projectBySlug } from '../../data/projects'
import { SEO } from 'astro-seo'
import '../../styles/main.scss'

const siteUrl = Astro.site?.toString() || 'https://amandaliczner.ca'
const project = projectBySlug('pathogen')!
---

<SEO
  title="Pathogen Risk to Wild Bumble Bees in Canada"
  description="Mapping where pathogen spillover from managed bees overlaps bumble bee conservation priority areas across Canada."
  canonical={`${siteUrl}/experience/pathogen`}
  openGraph={{
    basic: {
      title: 'Pathogen Risk & Bumble Bee Conservation Across Canada',
      type: 'article',
      image: `${siteUrl}/pictures/pathogen.jpg`,
      url: `${siteUrl}/experience/pathogen`,
    },
    optional: {
      description: 'Research mapping disease spillover risk from managed bees to wild bumble bees, identifying conservation priority areas at risk across Canada.',
      siteName: 'Dr. Amanda Liczner - Ecologist',
      locale: 'en_CA',
    },
    article: {
      authors: ['Dr. Amanda Liczner'],
      tags: ['bumble bees', 'pathogen spillover', 'disease transmission', 'conservation', 'managed bees', 'Canada'],
    },
    image: {
      url: `${siteUrl}/pictures/pathogen.jpg`,
      secureUrl: `${siteUrl}/pictures/pathogen.jpg`,
      alt: 'A wild bumble bee dusted with pollen foraging on a dandelion',
      type: 'image/jpeg',
      width: 3095,
      height: 2391,
    }
  }}
  twitter={{
    card: 'summary_large_image',
    site: '@amandaliczner',
    creator: '@amandaliczner',
    title: 'Pathogen Risk to Wild Bumble Bees Across Canada',
    description: 'Mapping disease spillover risk from managed bees to wild populations, identifying conservation hotspots.',
    image: `${siteUrl}/pictures/pathogen.jpg`,
    imageAlt: 'A wild bumble bee dusted with pollen foraging on a dandelion',
  }}
  extend={{
    meta: [
      { name: 'keywords', content: 'bumble bee pathogens, disease spillover, managed bees, wild bees, pathogen transmission, bumble bee conservation, Canada bee health, pollinator disease, conservation priority areas' },
      { name: 'author', content: 'Dr. Amanda Liczner' },
      { name: 'robots', content: 'index, follow' },
      { property: 'article:author', content: 'Dr. Amanda Liczner' },
      { property: 'article:section', content: 'Research' },
      { name: 'geo.region', content: 'CA' },
    ],
    link: [
      { rel: 'alternate', hreflang: 'en-ca', href: `${siteUrl}/experience/pathogen` },
      { rel: 'alternate', hreflang: 'en', href: `${siteUrl}/experience/pathogen` },
    ]
  }}
/>

<!-- ScholarlyArticle Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  'headline': 'Pathogen Risk to Bumble Bees Across Canada',
  'description': 'Research mapping pathogen spillover risk from managed bees to wild bumble bee populations across Canada, identifying high-priority conservation areas at risk of disease transmission.',
  'author': {
    '@type': 'Person',
    'name': 'Dr. Amanda Liczner',
    'jobTitle': 'Behavioural and Conservation Ecologist',
    'url': siteUrl
  },
  'about': ['Bumble Bees', 'Pathogen Spillover', 'Disease Transmission', 'Conservation Biology', 'Managed Bees', 'Wildlife Health'],
  'keywords': 'bumble bees, pathogens, disease spillover, managed bees, conservation, Canada, bee health',
  'url': `${siteUrl}/experience/pathogen`,
  'image': `${siteUrl}/pictures/pathogen.jpg`,
  'inLanguage': 'en-CA',
  'spatialCoverage': {
    '@type': 'Place',
    'name': 'Canada'
  }
})} />

<!-- Breadcrumb Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Home',
      'item': siteUrl
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': 'Research',
      'item': `${siteUrl}/experience`
    },
    {
      '@type': 'ListItem',
      'position': 3,
      'name': 'Pathogen Risk Research',
      'item': `${siteUrl}/experience/pathogen`
    }
  ]
})} />
---

<style>
  /* Numbered reference lists only - must not leak into the breadcrumb or
     the outputs list, which are also <li> elements on these pages. */
  .references li {
    margin-left: 5%;
    margin-bottom: 5px;
    list-style-type: decimal;
  }
</style>
<Layout title="Pathogen Risk to Bumble Bees - Amanda Liczner">
  <Sidebar class="lg:hidden" />
  <Header />
  <Content>
    <Article>
      <Heading
        slot="header"
        level={1}
        gradient
        class="inline-block"
        text="Pathogen risk to bumble bees across Canada"
      />

      <div class="flex flex-col gap-6">
        <nav aria-label="Breadcrumb" class="text-sm text-neutral-600">
          <ol class="flex flex-wrap items-center gap-2">
            <li>
              <a href="/" class="hover:text-primary transition-colors">Home</a>
            </li>
            <li aria-hidden="true">/</li>
            <li>
              <a href="/experience" class="hover:text-primary transition-colors"
                >Research</a
              >
            </li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="text-primary font-medium">
              {project.title}
            </li>
          </ol>
        </nav>

        <ProjectMeta rows={project.meta} />
      </div>

      <div class="mx-auto overflow-hidden md:max-w-3xl my-4 md:text-xl">
        <div class="md:flex my-4 md:space-x-4">
          <div class="md:w-3/5">
            Bumble bees are facing many challenges, and one growing concern is
            the spread of diseases from managed bees to wild populations. While
            scientists have known about this risk for years, few studies have
            mapped out where the danger is highest. Our research looked at this
            issue across Canada, identifying areas where conservation efforts
            for bumble bees overlap with regions at risk of disease spillover
            from managed bees.
          </div>
          <div class="md:w-2/5 my-4">
            <img
              class="h-72 w-full object-cover md:h-full rounded-2xl"
              src="/pictures/pathogen.jpg"
              alt="A wild bumble bee dusted with pollen foraging on a dandelion, the kind of shared flower that can transmit pathogens between managed and wild bees"
              loading="lazy"
            />
          </div>
        </div>
        <div class="md:flex md:space-x-4">
          <div class="my-4">
            We found that more than 15% of high-priority conservation areas for
            bumble bees are at risk, with hotspots in southwest Alberta,
            southern British Columbia, southern Ontario, and southern
            Quebec, places that also happen to be home to the richest
            diversity of bumble bee species. The risk isn&rsquo;t limited to
            farms or cities; even natural areas could be affected.
          </div>
        </div>
        <div class="md:flex md:space-x-4">
          <div class="my-4">
            To help protect wild bumble bees, we need to adopt better management
            practices, such as screening managed bees for disease, improving
            colony care, treating infections, and setting up national monitoring
            and reporting programs. Our findings give conservation groups and
            policymakers the tools to focus their efforts where they&rsquo;re
            needed most, helping to safeguard these essential pollinators and
            the ecosystems they support.
          </div>
        </div>
      </div>

      <div class="mx-auto md:max-w-3xl w-full flex flex-col gap-10">
        <section>
          <Heading
            level={2}
            gradient
            class="inline-block mb-4"
            text="Research significance"
          />
          <p class="text-neutral-600 text-base md:text-lg leading-relaxed">
            {project.significance}
          </p>
        </section>

        <section>
          <Heading
            level={2}
            gradient
            class="inline-block mb-4"
            text="Outputs"
          />
          <ul class="list-disc pl-5 space-y-3">
            {
              project.outputs.map((output) => (
                <li class="text-neutral-600 text-sm md:text-base leading-relaxed">
                  {output}
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </Article>
  </Content>
</Layout>
