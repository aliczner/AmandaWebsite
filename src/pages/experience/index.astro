---
import { SEO } from 'astro-seo'
import Layout from '../../layouts/Layout.astro'
import Sidebar from '../../layouts/Sidebar.astro'
import Header from '../../components/Header.astro'
import ProjectCard from '../../components/ProjectCard.astro'
import PersonSchema from '../../components/PersonSchema.astro'
import { themes, projectsInTheme } from '../../data/projects'
import { positions, graduateResearch } from '../../data/positions'
import '../../styles/main.scss'

const siteUrl = Astro.site?.toString() || 'https://amandaliczner.ca'

// TODO: replace with the migration/connectivity photo once Amanda supplies it.
// Drop the file in public/pictures/ and set this to its path, e.g.
// const migrationImage = '/pictures/migration.jpg'
const migrationImage: string | null = null
---

<SEO
  title="Research - Dr. Amanda Liczner | Behavioural Conservation & Animal Movement"
  description="Dr. Amanda Liczner's research: how behavioural decisions, habitat selection, and movement determine where populations persist. Radio telemetry, Motus wildlife tracking, habitat selection across the life cycle, and spatial conservation planning, with bumble bees as a model organism."
  canonical={`${siteUrl}/experience`}
  openGraph={{
    basic: {
      title: 'Research - Dr. Amanda Liczner',
      type: 'website',
      image: `${siteUrl}/pictures/Experience2.jpg`,
      url: `${siteUrl}/experience`,
    },
    optional: {
      description:
        'Behavioural conservation research on animal movement, habitat selection across the life cycle, and landscape-scale conservation planning.',
      siteName: 'Dr. Amanda Liczner - Ecologist',
      locale: 'en_CA',
    },
    image: {
      url: `${siteUrl}/pictures/Experience2.jpg`,
      secureUrl: `${siteUrl}/pictures/Experience2.jpg`,
      alt: 'Dr. Amanda Liczner conducting field research',
      type: 'image/jpeg',
      width: 1200,
      height: 800,
    },
  }}
  twitter={{
    card: 'summary_large_image',
    title: 'Research - Dr. Amanda Liczner',
    description:
      'Behavioural conservation: animal movement, habitat selection, and conservation planning.',
    image: `${siteUrl}/pictures/Experience2.jpg`,
    imageAlt: 'Dr. Amanda Liczner field research',
  }}
  extend={{
    meta: [
      {
        name: 'keywords',
        content:
          'behavioural conservation, animal movement research, habitat selection, radio telemetry, bumble bee model organism, movement ecology, Motus wildlife tracking, avian migration, connectivity conservation, conservation prioritization, pollinator research',
      },
      { name: 'author', content: 'Dr. Amanda Liczner' },
      {
        name: 'robots',
        content: 'index, follow, max-image-preview:large, max-snippet:-1',
      },
      { name: 'geo.region', content: 'CA' },
    ],
    link: [
      { rel: 'alternate', hreflang: 'en-ca', href: `${siteUrl}/experience` },
      { rel: 'alternate', hreflang: 'en', href: `${siteUrl}/experience` },
    ],
  }}
/>

<Layout title="Research - Dr. Amanda Liczner">
  <Sidebar class="lg:hidden" />
  <Header />

  <PersonSchema />

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Research',
          item: `${siteUrl}/experience`,
        },
      ],
    })}
  />

  <main>
    <!-- Hero -->
    <section class="relative py-20 lg:py-28 overflow-hidden">
      <div
        class="absolute inset-0 bg-gradient-to-br from-primary/5 via-secondary/5 to-primary/10"
      >
      </div>

      <div class="container relative px-4 sm:px-6">
        <div class="max-w-4xl mx-auto text-center">
          <nav aria-label="Breadcrumb" class="mb-6">
            <ol
              class="flex items-center justify-center gap-2 text-sm text-neutral-600"
            >
              <li>
                <a href="/" class="hover:text-primary transition-colors">Home</a
                >
              </li>
              <li aria-hidden="true">/</li>
              <li aria-current="page" class="text-primary font-medium">
                Research
              </li>
            </ol>
          </nav>

          <h1
            class="text-4xl sm:text-5xl lg:text-6xl font-medium text-neutral-700 mb-6"
          >
            <span
              class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent"
            >
              Research
            </span>
          </h1>
          <p
            class="text-lg sm:text-xl lg:text-2xl text-neutral-600 max-w-3xl mx-auto leading-relaxed"
          >
            How behavioural decisions, habitat selection, and movement determine
            where populations persist, and how to turn that into conservation
            action.
          </p>
        </div>
      </div>
    </section>

    <!-- Migration priority areas and connectivity science -->
    <section id="migration" class="py-12 lg:py-20">
      <div class="container px-4 sm:px-6">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-medium mb-8">
            <span
              class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent"
            >
              Migration priority areas and connectivity science
            </span>
          </h2>

          <div
            class="bg-surface border border-primary/10 rounded-3xl shadow-lg p-6 lg:p-8"
          >
            <div class="grid gap-6 lg:gap-8 md:grid-cols-5 items-start">
              <div class="md:col-span-3 flex flex-col gap-4">
                <p class="text-neutral-600 text-base lg:text-lg leading-relaxed">
                  At Western University I model the movement of migratory birds
                  and bats, using the continental Motus Wildlife Tracking System
                  to identify priority areas for migration across the Great
                  Lakes region of northeastern North America. It is a key
                  migratory region, so the results matter for mitigating threats
                  to migrating individuals. This builds on a multi-institution
                  synthesis I led on the advances and unresolved challenges in
                  ecological connectivity science, which set out how to move
                  beyond static connectivity maps towards representations that
                  reflect the actual movement and behaviour of organisms.
                </p>
                <p class="text-neutral-600 text-base lg:text-lg leading-relaxed">
                  During my PhD I used spatial priority mapping to identify
                  where conservation action for bumble bees would be most
                  effective across Canada under different future climate
                  scenarios, and characterised habitat at both local and
                  landscape scales. Broad recommendations for creating or
                  conserving pollinator habitat are unlikely to benefit all
                  at-risk species, because their needs differ.
                </p>
                <p class="text-base">
                  <a
                    href="/publications"
                    class="text-primary hover:text-primary/80 underline transition-colors font-medium"
                  >
                    Related publications
                  </a>
                </p>
              </div>

              <div class="md:col-span-2">
                {
                  migrationImage ? (
                    <img
                      src={migrationImage}
                      alt="Migratory bird tracking fieldwork for the Motus movement analysis"
                      loading="lazy"
                      class="w-full h-64 md:h-full md:min-h-[18rem] object-cover rounded-2xl shadow-md"
                    />
                  ) : (
                    <div
                      class="w-full h-64 md:min-h-[18rem] rounded-2xl border-2 border-dashed border-primary/25 bg-primary/5 flex flex-col items-center justify-center gap-2 text-center px-4"
                      role="img"
                      aria-label="Placeholder for a migration and connectivity image"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        class="w-10 h-10 text-primary/40"
                        aria-hidden="true"
                      >
                        <rect x="3" y="3" width="18" height="18" rx="2" />
                        <circle cx="8.5" cy="8.5" r="1.5" />
                        <path d="m21 15-5-5L5 21" />
                      </svg>
                      <p class="text-sm text-neutral-500 mx-auto">
                        Image to come
                      </p>
                    </div>
                  )
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Themes -->
    {
      themes.map((theme, index) => (
        <section
          id={theme.id}
          class:list={[
            'py-12 lg:py-20',
            index % 2 === 0 ? 'bg-primary/5' : '',
          ]}
        >
          <div class="container px-4 sm:px-6">
            <div class="max-w-6xl mx-auto">
              <div class="mb-8 lg:mb-10">
                <h2 class="text-3xl sm:text-4xl lg:text-5xl font-medium mb-4">
                  <span class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">
                    {theme.title}
                  </span>
                </h2>
                <p class="text-lg sm:text-xl text-neutral-700 italic mb-4">
                  {theme.framing}
                </p>
                <p class="text-base lg:text-lg text-neutral-600 leading-relaxed">
                  {theme.body}
                </p>
              </div>

              <div class="space-y-8 lg:space-y-12">
                {projectsInTheme(theme.id).map((project) => (
                  <ProjectCard
                    image={project.image}
                    imageAlt={project.imageAlt}
                    title={project.title}
                    description={project.description}
                    buttonText="Read more"
                    buttonLink={`/experience/${project.slug}`}
                  />
                ))}
              </div>
            </div>
          </div>
        </section>
      ))
    }

    <!-- Earlier work -->
    <section id="earlier-work" class="py-12 lg:py-16">
      <div class="container px-4 sm:px-6">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-2xl lg:text-3xl font-medium mb-4">
            <span
              class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent"
            >
              Earlier work
            </span>
          </h2>
          <p class="text-base lg:text-lg text-neutral-600 leading-relaxed">
            Seven of my peer-reviewed papers come from earlier work on
            plant&ndash;plant facilitation and restoration in Californian desert
            and invaded arid shrubland systems, alongside alpine-tundra
            germination experiments and lake surveys in northern Ontario. That
            is where the systematic review, meta-analysis, and experimental
            design skills the current work depends on were built.
          </p>
        </div>
      </div>
    </section>

    <!-- Appointments -->
    <section id="appointments" class="py-12 lg:py-20 bg-primary/5">
      <div class="container px-4 sm:px-6">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-medium mb-10">
            <span
              class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent"
            >
              Research appointments
            </span>
          </h2>

          <ol class="flex flex-col gap-6">
            {
              positions.map((position) => (
                <li class="bg-surface p-6 lg:p-8 rounded-3xl shadow-lg border border-primary/10">
                  <div class="flex flex-wrap items-baseline justify-between gap-2 mb-2">
                    <h3 class="text-xl lg:text-2xl font-semibold text-neutral-700 max-w-none">
                      {position.title}
                    </h3>
                    <p class="text-sm lg:text-base text-neutral-500 font-medium">
                      {position.dates}
                    </p>
                  </div>
                  <p class="text-lg text-neutral-700 mb-1">
                    {position.organisation}
                    {position.unit ? `, ${position.unit}` : ''}
                  </p>
                  {position.supervisors && (
                    <p class="text-sm text-neutral-500 mb-3">
                      Supervised by {position.supervisors}
                    </p>
                  )}
                  <p class="text-neutral-600 leading-relaxed">
                    {position.focus}
                  </p>
                </li>
              ))
            }
          </ol>

          <h3
            class="text-2xl lg:text-3xl font-medium mt-12 mb-6 text-neutral-700"
          >
            Graduate research
          </h3>
          <ol class="flex flex-col gap-6">
            {
              graduateResearch.map((degree) => (
                <li class="bg-surface p-6 lg:p-8 rounded-3xl shadow-md border border-primary/10">
                  <div class="flex flex-wrap items-baseline justify-between gap-2 mb-2">
                    <h4 class="text-lg lg:text-xl font-semibold text-neutral-700 max-w-none">
                      {degree.degree}
                    </h4>
                    <p class="text-sm text-neutral-500 font-medium">
                      {degree.dates}
                    </p>
                  </div>
                  <p class="text-base text-neutral-700 mb-1">
                    {degree.organisation}
                  </p>
                  <p class="text-sm text-neutral-500 mb-3">
                    Supervised by {degree.supervisor}
                  </p>
                  <p class="text-neutral-600 leading-relaxed">{degree.focus}</p>
                </li>
              ))
            }
          </ol>

          <p class="text-base text-neutral-600 mt-8">
            Dissertation titles, awards, teaching, and service are listed on the
            <a
              href="/skills-education"
              class="text-primary hover:text-primary/80 underline transition-colors"
              >CV and expertise page</a
            >.
          </p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 lg:py-24">
      <div class="container mx-auto px-4 sm:px-6">
        <div class="max-w-4xl mx-auto relative">
          <div
            class="absolute inset-0 bg-gradient-to-br from-primary/20 via-secondary/15 to-primary/10 rounded-3xl blur-sm"
            aria-hidden="true"
          >
          </div>

          <div
            class="relative border border-primary/20 rounded-3xl overflow-hidden shadow-xl"
          >
            <div
              class="flex flex-col gap-8 lg:gap-12 bg-gradient-to-br from-surface via-surface to-primary/5 px-6 sm:px-8 lg:px-12 xl:px-16 py-12 lg:py-20 text-center items-center"
            >
              <div class="flex flex-col gap-4">
                <h2
                  class="text-neutral-700 text-3xl sm:text-4xl lg:text-5xl font-medium mx-auto"
                >
                  Research outputs
                </h2>
                <p
                  class="text-neutral-600 text-base sm:text-lg lg:text-xl max-w-2xl mx-auto"
                >
                  Papers, talks, and the full academic record arising from these
                  positions.
                </p>
              </div>

              <div class="flex flex-col sm:flex-row gap-4">
                <a
                  href="/publications"
                  class="px-8 py-4 rounded-xl transition-all duration-300 ease-out shadow-lg font-medium bg-primary text-white hover:shadow-2xl hover:scale-105 hover:bg-primary/80 hover:-translate-y-1"
                >
                  Publications
                </a>
                <a
                  href="/skills-education"
                  class="px-8 py-4 rounded-xl transition-all duration-300 ease-out shadow-lg font-medium bg-primary/90 text-white hover:shadow-2xl hover:scale-105 hover:bg-primary/80 hover:-translate-y-1"
                >
                  CV &amp; Expertise
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
