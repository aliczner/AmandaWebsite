---
import Layout from '../../layouts/Layout.astro'
import Sidebar from '../../layouts/Sidebar.astro'
import Header from '../../components/Header.astro'
import PersonSchema from '../../components/PersonSchema.astro'
import { SEO } from 'astro-seo'
import { SHOW_CONSULTING_IN_NAV } from '../../data/site'
import { media, engagement } from '../../data/outreach'
import '../../styles/main.scss'

const siteUrl = Astro.site?.toString() || 'https://amandaliczner.ca'

const coverage = media.filter((item) => !item.byHer)
const ownWriting = media.filter((item) => item.byHer)
---

<SEO
  title="Outreach & Science Communication - Dr. Amanda Liczner"
  description="Science communication and public engagement by Dr. Amanda Liczner: media coverage of her bumble bee tracking research, community science with Bumble Bee Watch, pollinator education with Pollination Guelph, public talks, and pollinator colouring books."
  canonical={`${siteUrl}/outreach`}
  openGraph={{
    basic: {
      title: 'Outreach & Science Communication - Dr. Amanda Liczner',
      type: 'website',
      image: `${siteUrl}/pictures/Bumble.jpg`,
      url: `${siteUrl}/outreach`,
    },
    optional: {
      description:
        'Media coverage, community science, pollinator education, public talks, and colouring books that make pollinator science accessible.',
      siteName: 'Dr. Amanda Liczner - Ecologist',
      locale: 'en_CA',
    },
    image: {
      url: `${siteUrl}/pictures/Bumble.jpg`,
      secureUrl: `${siteUrl}/pictures/Bumble.jpg`,
      alt: 'A radio-tagged bumble bee, the subject of widely covered tracking research',
      type: 'image/jpeg',
      width: 1200,
      height: 800,
    },
  }}
  twitter={{
    card: 'summary_large_image',
    title: 'Outreach & Science Communication - Dr. Amanda Liczner',
    description:
      'Media coverage, community science, pollinator education and public talks.',
    image: `${siteUrl}/pictures/Bumble.jpg`,
    imageAlt: 'A radio-tagged bumble bee',
  }}
  extend={{
    meta: [
      {
        name: 'keywords',
        content:
          'science communication, pollinator education, Bumble Bee Watch, community science, Pollination Guelph, public engagement ecology, bees with backpacks, pollinator outreach, knowledge mobilisation',
      },
      { name: 'author', content: 'Dr. Amanda Liczner' },
      {
        name: 'robots',
        content: 'index, follow, max-image-preview:large, max-snippet:-1',
      },
      { name: 'geo.region', content: 'CA' },
    ],
    link: [
      { rel: 'alternate', hreflang: 'en-ca', href: `${siteUrl}/outreach` },
      { rel: 'alternate', hreflang: 'en', href: `${siteUrl}/outreach` },
    ],
  }}
/>

<Layout title="Outreach & Science Communication - Dr. Amanda Liczner">
  <Sidebar class="lg:hidden" />
  <Header />

  <PersonSchema />

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Outreach',
          item: `${siteUrl}/outreach`,
        },
      ],
    })}
  />

  <main>
    <!-- Hero -->
    <section class="relative py-20 lg:py-28 overflow-hidden">
      <div
        class="absolute inset-0 bg-gradient-to-br from-primary/5 via-secondary/5 to-primary/10"
      >
      </div>

      <div class="container relative px-4 sm:px-6">
        <div class="max-w-4xl mx-auto text-center">
          <nav aria-label="Breadcrumb" class="mb-6">
            <ol
              class="flex items-center justify-center gap-2 text-sm text-neutral-600"
            >
              <li>
                <a href="/" class="hover:text-primary transition-colors">Home</a
                >
              </li>
              <li aria-hidden="true">/</li>
              <li aria-current="page" class="text-primary font-medium">
                Outreach
              </li>
            </ol>
          </nav>

          <h1
            class="text-4xl sm:text-5xl lg:text-6xl font-medium text-neutral-700 mb-6"
          >
            <span
              class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent"
            >
              Outreach &amp; science communication
            </span>
          </h1>
          <p
            class="text-lg sm:text-xl lg:text-2xl text-neutral-600 max-w-3xl mx-auto leading-relaxed"
          >
            Media coverage, public engagement and community science, and
            pollinator colouring books for children and adults.
          </p>
        </div>
      </div>
    </section>

    <!-- Media -->
    <section id="media" class="py-12 lg:py-20">
      <div class="container px-4 sm:px-6">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-medium mb-10">
            <span
              class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent"
            >
              Media coverage
            </span>
          </h2>

          <ul class="flex flex-col gap-4 mb-12">
            {
              coverage.map((item) => (
                <li class="bg-surface p-6 rounded-3xl shadow-md border border-primary/10">
                  <div class="flex flex-wrap items-baseline justify-between gap-2">
                    <h3 class="text-lg font-semibold text-neutral-700 max-w-none">
                      {item.url ? (
                        <a
                          href={item.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-primary hover:text-primary/80 underline transition-colors"
                        >
                          {item.title}
                        </a>
                      ) : (
                        item.title
                      )}
                    </h3>
                    <p class="text-sm text-neutral-500 font-medium">
                      {item.year}
                    </p>
                  </div>
                  <p class="text-neutral-600 mt-1">
                    {item.outlet}, {item.author}
                  </p>
                </li>
              ))
            }
          </ul>

          <h2 class="text-2xl lg:text-3xl font-medium mb-6">
            <span
              class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent"
            >
              Popular writing
            </span>
          </h2>
          <ul class="flex flex-col gap-4">
            {
              ownWriting.map((item) => (
                <li class="bg-surface p-6 rounded-3xl shadow-md border border-primary/10">
                  <div class="flex flex-wrap items-baseline justify-between gap-2">
                    <h3 class="text-lg font-semibold text-neutral-700 max-w-none">
                      {item.url ? (
                        <a
                          href={item.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-primary hover:text-primary/80 underline transition-colors"
                        >
                          {item.title}
                        </a>
                      ) : (
                        item.title
                      )}
                    </h3>
                    <p class="text-sm text-neutral-500 font-medium">
                      {item.year}
                    </p>
                  </div>
                  <p class="text-neutral-600 mt-1">{item.outlet}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- Public engagement -->
    <section
      id="public-engagement"
      class="py-12 lg:py-20 bg-primary/5"
    >
      <div class="container px-4 sm:px-6">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-medium mb-10">
            <span
              class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent"
            >
              Public engagement &amp; community science
            </span>
          </h2>

          <ul class="flex flex-col gap-4">
            {
              engagement.map((item) => (
                <li class="bg-surface p-6 lg:p-8 rounded-3xl shadow-md border border-primary/10">
                  <div class="flex flex-wrap items-baseline justify-between gap-2">
                    <h3 class="text-lg lg:text-xl font-semibold text-neutral-700 max-w-none">
                      {item.role}
                    </h3>
                    <p class="text-sm text-neutral-500 font-medium">
                      {item.years}
                    </p>
                  </div>
                  <p class="text-base text-neutral-700 mt-1">
                    {item.organisation}
                  </p>
                  <p class="text-neutral-600 leading-relaxed mt-3">
                    {item.detail}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- Books -->
    <section id="books" class="py-12 lg:py-20">
      <div class="container px-4 sm:px-6">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-medium mb-8">
            <span
              class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent"
            >
              Colouring books
            </span>
          </h2>

          <div
            class="bg-surface p-6 lg:p-8 rounded-3xl shadow-lg border border-primary/10 grid gap-6 md:grid-cols-3 items-center"
          >
            <div class="md:col-span-2 flex flex-col gap-4">
              <p class="text-neutral-600 text-base lg:text-lg leading-relaxed">
                I write and illustrate pollinator-themed colouring books for
                children and adults, published independently. They came out of
                outreach work: the questions children actually ask about bees are the
                ones no field guide answers. They reach an audience
                that peer-reviewed publications do not.
              </p>
              <p>
                <a
                  href="/books"
                  class="text-primary hover:text-primary/80 underline transition-colors font-medium"
                  >Browse the colouring books</a
                >
              </p>
            </div>
            <div class="md:col-span-1">
              <img
                src="/pictures/pollinator-abc-kids.jpg"
                alt="Cover of the Pollinator ABC colouring book"
                loading="lazy"
                class="w-full h-auto rounded-2xl shadow-md"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    {
      SHOW_CONSULTING_IN_NAV && (
        <section
          id="consulting"
          class="pb-12 lg:pb-20"
        >
          <div class="container px-4 sm:px-6">
            <div class="max-w-5xl mx-auto">
              <div class="bg-surface p-6 lg:p-8 rounded-3xl shadow-md border border-primary/10">
                <p class="text-neutral-600 text-base lg:text-lg leading-relaxed">
                  I also take selected ecological consulting contracts:
                  landscape connectivity assessment, habitat suitability
                  modelling, statistical analysis, and evidence synthesis.{' '}
                  <a
                    href="/services"
                    class="text-primary hover:text-primary/80 underline transition-colors font-medium"
                  >
                    Details
                  </a>
                  .
                </p>
              </div>
            </div>
          </div>
        </section>
      )
    }

    <!-- CTA -->
    <section class="py-16 lg:py-24">
      <div class="container mx-auto px-4 sm:px-6">
        <div class="max-w-4xl mx-auto relative">
          <div
            class="absolute inset-0 bg-gradient-to-br from-primary/20 via-secondary/15 to-primary/10 rounded-3xl blur-sm"
            aria-hidden="true"
          >
          </div>

          <div
            class="relative border border-primary/20 rounded-3xl overflow-hidden shadow-xl"
          >
            <div
              class="flex flex-col gap-8 lg:gap-12 bg-gradient-to-br from-surface via-surface to-primary/5 px-6 sm:px-8 lg:px-12 xl:px-16 py-12 lg:py-20 text-center items-center"
            >
              <div class="flex flex-col gap-4">
                <h2
                  class="text-neutral-700 text-3xl sm:text-4xl lg:text-5xl font-medium mx-auto"
                >
                  Talks and workshops
                </h2>
                <p
                  class="text-neutral-600 text-base sm:text-lg lg:text-xl max-w-2xl mx-auto"
                >
                  I am glad to speak to community groups, schools, and
                  naturalist societies about pollinators, animal tracking, and
                  conservation.
                </p>
              </div>

              <div class="flex flex-col sm:flex-row gap-4">
                <a
                  href="/contact"
                  class="px-8 py-4 rounded-xl transition-all duration-300 ease-out shadow-lg font-medium bg-primary text-white hover:shadow-2xl hover:scale-105 hover:bg-primary/80 hover:-translate-y-1"
                >
                  Get in touch
                </a>
                <a
                  href="/experience"
                  class="px-8 py-4 rounded-xl transition-all duration-300 ease-out shadow-lg font-medium bg-primary/90 text-white hover:shadow-2xl hover:scale-105 hover:bg-primary/80 hover:-translate-y-1"
                >
                  Research
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
