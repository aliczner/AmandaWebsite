---
import Button from '../components/Button.astro'
import CTA from '../sections/CTA.astro'
import Header from '../components/Header.astro'
import Hero from '../sections/Hero.astro'
import Intro from '../sections/Intro.astro'
import Layout from '../layouts/Layout.astro'
import Sidebar from '../layouts/Sidebar.astro'
import AboutMe from '../sections/AboutMe.astro'
import PersonSchema from '../components/PersonSchema.astro'
import { SEO } from 'astro-seo'
import '../styles/main.scss'

const siteUrl = Astro.site?.toString() || 'https://amandaliczner.ca'

const description =
  'Dr. Amanda Liczner is a behavioural and conservation ecologist studying how animal decision-making, habitat selection, and movement determine where populations persist, using bumble bees as a model organism alongside landscape-scale tracking of migratory birds and bats.'
---

<SEO
  title="Dr. Amanda Liczner - Behavioural & Conservation Ecologist | Animal Movement and Habitat Selection"
  description={description}
  canonical={`${siteUrl}/`}
  openGraph={{
    basic: {
      title:
        'Dr. Amanda Liczner - Behavioural & Conservation Ecologist | Animal Movement and Habitat Selection',
      type: 'website',
      image: `${siteUrl}/pictures/AmandaLiczner.jpg`,
      url: siteUrl,
    },
    optional: {
      description:
        'Behavioural and conservation ecologist working on animal movement, habitat selection, and spatial conservation planning, with bumble bees as a model organism.',
      siteName: 'Dr. Amanda Liczner - Behavioural & Conservation Ecologist',
      locale: 'en_CA',
    },
    image: {
      url: `${siteUrl}/pictures/AmandaLiczner.jpg`,
      secureUrl: `${siteUrl}/pictures/AmandaLiczner.jpg`,
      alt: 'Dr. Amanda Liczner, behavioural and conservation ecologist',
      type: 'image/jpeg',
      width: 600,
      height: 600,
    },
  }}
  twitter={{
    card: 'summary_large_image',
    title: 'Dr. Amanda Liczner - Behavioural & Conservation Ecologist',
    description:
      'Animal movement, habitat selection, and conservation planning, with bumble bees as a model organism.',
    image: `${siteUrl}/pictures/AmandaLiczner.jpg`,
    imageAlt: 'Dr. Amanda Liczner',
  }}
  extend={{
    meta: [
      {
        name: 'keywords',
        content:
          'Amanda Liczner, behavioural ecology, conservation ecology, animal movement, movement ecology, habitat selection, radio telemetry, bumble bee model organism, pollinator conservation, landscape connectivity, spatial conservation planning, avian migration, conservation biologist Canada',
      },
      { name: 'author', content: 'Dr. Amanda Liczner' },
      { name: 'robots', content: 'index, follow, max-image-preview:large' },
      { name: 'geo.region', content: 'CA' },
    ],
    link: [
      { rel: 'alternate', hreflang: 'en-ca', href: siteUrl },
      { rel: 'alternate', hreflang: 'en', href: siteUrl },
    ],
  }}
/>

<PersonSchema />

<!-- WebSite Schema -->
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Dr. Amanda Liczner - Behavioural & Conservation Ecologist',
    url: siteUrl,
    description:
      'Personal website of Dr. Amanda Liczner, behavioural and conservation ecologist working on animal movement, habitat selection, and conservation planning.',
    author: {
      '@type': 'Person',
      name: 'Dr. Amanda Liczner',
    },
    inLanguage: 'en-CA',
  })}
/>

<Layout title="Dr. Amanda Liczner - Behavioural & Conservation Ecologist">
  <Sidebar class="lg:hidden" />
  <Header />
  <main>
    <Hero
      align="center"
      title=" <strong>Dr. Amanda Liczner</strong>"
      description="Behavioural conservation &bull; Animal movement &amp; habitat selection"
    />
    <Intro />
    <AboutMe />
    <CTA
      align="center"
      title="Let's talk about the science"
      description="I welcome enquiries from prospective graduate students, collaborators, and search committees. If you are interested in animal behaviour, habitat selection, or conservation planning, I would like to hear from you."
    >
      <div class="flex flex-col sm:flex-row gap-4">
        <Button
          href="/contact"
          text="Get in touch"
          className="text-xl tracking-wide"
          variant="primary"
        />
        <Button
          href="/skills-education"
          text="CV & Expertise"
          className="text-xl tracking-wide"
          variant="secondary"
        />
      </div>
    </CTA>
  </main>
</Layout>
