---
import Layout from '../../layouts/Layout.astro'
import Sidebar from '../../layouts/Sidebar.astro'
import Header from '../../components/Header.astro'
import PersonSchema from '../../components/PersonSchema.astro'
import { SEO } from 'astro-seo'
import { METRICS, CV_PATH, CV_PDF_IS_CURRENT } from '../../data/site'
import {
  publications,
  inPress,
  inPreparation,
  inPreparationNote,
  formatSource,
  highlightSelf,
  isLeadAuthor,
} from '../../data/publications'
import '../../styles/main.scss'

const siteUrl = Astro.site?.toString() || 'https://amandaliczner.ca'

const published = publications.filter((p) => p.status === 'published')
const pipelineHeading =
  inPress.length > 0 ? 'In press and in preparation' : 'In preparation'

const publicationList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Peer-reviewed publications of Dr. Amanda Liczner',
  numberOfItems: published.length,
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  itemListElement: published.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'ScholarlyArticle',
      name: p.title,
      author: p.authors.split(', ').map((n) => ({
        '@type': 'Person',
        name: n,
      })),
      datePublished: String(p.year),
      isPartOf: { '@type': 'Periodical', name: p.journal },
      ...(p.volume && { volumeNumber: p.volume }),
      ...(p.pages && { pagination: p.pages }),
      ...(p.doi && {
        identifier: `https://doi.org/${p.doi}`,
        sameAs: `https://doi.org/${p.doi}`,
      }),
      inLanguage: 'en',
    },
  })),
}

const metricTiles = [
  {
    figure: String(METRICS.publications),
    label: `peer-reviewed publications, ${METRICS.leadAuthor} as lead author`,
  },
  {
    figure: String(METRICS.conferenceTalks),
    label: `conference presentations, plus ${METRICS.invitedTalks} invited talks`,
  },
  {
    figure: METRICS.fellowshipTotal,
    label: 'in competitive fellowships and scholarships',
  },
  {
    figure: String(METRICS.reviews),
    label: `peer reviews for ${METRICS.journalsReviewedFor} journals`,
  },
]
---

<SEO
  title="Publications - Dr. Amanda Liczner | Behavioural & Conservation Ecology"
  description="Peer-reviewed publications by Dr. Amanda Liczner in behavioural ecology, animal movement, habitat selection, pollinator conservation, and spatial conservation planning. 16 peer-reviewed papers, 9 as lead author."
  canonical={`${siteUrl}/publications`}
  openGraph={{
    basic: {
      title: 'Publications - Dr. Amanda Liczner',
      type: 'website',
      image: `${siteUrl}/pictures/AmandaLiczner.jpg`,
      url: `${siteUrl}/publications`,
    },
    optional: {
      description:
        'Peer-reviewed research in behavioural ecology, animal movement, habitat selection, and conservation planning.',
      siteName: 'Dr. Amanda Liczner - Ecologist',
      locale: 'en_CA',
    },
    image: {
      url: `${siteUrl}/pictures/AmandaLiczner.jpg`,
      secureUrl: `${siteUrl}/pictures/AmandaLiczner.jpg`,
      alt: 'Dr. Amanda Liczner, behavioural and conservation ecologist',
      type: 'image/jpeg',
      width: 600,
      height: 600,
    },
  }}
  twitter={{
    card: 'summary_large_image',
    title: 'Publications - Dr. Amanda Liczner',
    description:
      '16 peer-reviewed papers in behavioural ecology, animal movement, and conservation.',
    image: `${siteUrl}/pictures/AmandaLiczner.jpg`,
    imageAlt: 'Dr. Amanda Liczner',
  }}
  extend={{
    meta: [
      {
        name: 'keywords',
        content:
          'Amanda Liczner publications, behavioural ecology papers, movement ecology research, habitat selection, bumble bee conservation, pollinator research, connectivity science, conservation prioritization, radio telemetry',
      },
      { name: 'author', content: 'Dr. Amanda Liczner' },
      {
        name: 'robots',
        content: 'index, follow, max-image-preview:large, max-snippet:-1',
      },
    ],
    link: [
      {
        rel: 'alternate',
        hreflang: 'en-ca',
        href: `${siteUrl}/publications`,
      },
      { rel: 'alternate', hreflang: 'en', href: `${siteUrl}/publications` },
    ],
  }}
/>

<Layout title="Publications - Dr. Amanda Liczner">
  <Sidebar class="lg:hidden" />
  <Header />

  <PersonSchema />

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(publicationList)}
  />

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Publications',
          item: `${siteUrl}/publications`,
        },
      ],
    })}
  />

  <main>
    <!-- Hero -->
    <section class="relative py-20 lg:py-28 overflow-hidden">
      <div
        class="absolute inset-0 bg-gradient-to-br from-primary/5 via-secondary/5 to-primary/10"
      >
      </div>

      <div class="container relative px-4 sm:px-6">
        <div class="max-w-4xl mx-auto text-center">
          <nav aria-label="Breadcrumb" class="mb-6">
            <ol
              class="flex items-center justify-center gap-2 text-sm text-neutral-600"
            >
              <li>
                <a href="/" class="hover:text-primary transition-colors">Home</a
                >
              </li>
              <li aria-hidden="true">/</li>
              <li aria-current="page" class="text-primary font-medium">
                Publications
              </li>
            </ol>
          </nav>

          <h1
            class="text-4xl sm:text-5xl lg:text-6xl font-medium text-neutral-700 mb-6"
          >
            <span
              class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent"
            >
              Publications
            </span>
          </h1>
          <p
            class="text-lg sm:text-xl lg:text-2xl text-neutral-600 max-w-3xl mx-auto leading-relaxed"
          >
            Peer-reviewed research in behavioural ecology, animal movement,
            habitat selection, and conservation planning.
          </p>
        </div>
      </div>
    </section>

    <!-- Metrics -->
    <section class="pb-12 lg:pb-16 relative">
      <div class="container px-4 sm:px-6">
        <div class="max-w-6xl mx-auto">
          <ul
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8"
          >
            {
              metricTiles.map((tile) => (
                <li class="bg-surface p-6 rounded-3xl shadow-lg border border-primary/10 text-center">
                  <p class="text-3xl lg:text-4xl font-medium bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">
                    {tile.figure}
                  </p>
                  <p class="text-sm lg:text-base text-neutral-600 mt-2 mx-auto">
                    {tile.label}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- All peer-reviewed publications -->
    <section class="py-12 lg:py-20 bg-primary/5">
      <div class="container px-4 sm:px-6">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-medium mb-4">
            <span
              class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent"
            >
              Peer-reviewed publications
            </span>
          </h2>
          <p class="text-lg text-neutral-600 mb-10">
            {METRICS.publications} publications, {METRICS.leadAuthor} as lead
            author.
          </p>

          <ol class="flex flex-col gap-6">
            {
              published.map((p) => (
                <li class="bg-surface p-6 rounded-3xl shadow-md border border-primary/10 flex flex-col gap-2">
                  <div class="flex items-baseline gap-3 flex-wrap">
                    <span class="text-sm font-medium text-neutral-400">
                      {p.id}
                    </span>
                    <span class="text-sm text-neutral-500">{p.year}</span>
                    {isLeadAuthor(p) && (
                      <span class="text-xs font-medium text-primary bg-primary/10 border border-primary/20 rounded-full px-3 py-0.5">
                        Lead author
                      </span>
                    )}
                  </div>
                  <h3 class="text-lg lg:text-xl font-semibold text-neutral-700 max-w-none">
                    {p.title}
                  </h3>
                  <p
                    class="text-neutral-600 text-sm lg:text-base"
                    set:html={highlightSelf(p.authors)}
                  />
                  <p class="text-neutral-500 text-sm lg:text-base italic">
                    {formatSource(p)}
                  </p>
                  {p.doi && (
                    <p class="text-sm">
                      <a
                        href={`https://doi.org/${p.doi}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-primary hover:text-primary/80 underline transition-colors"
                      >
                        doi:{p.doi}
                      </a>
                    </p>
                  )}
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </section>

    <!-- In press and in preparation -->
    <section
      class="py-12 lg:py-20 bg-primary/5"
    >
      <div class="container px-4 sm:px-6">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-medium mb-10">
            <span
              class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent"
            >
              {pipelineHeading}
            </span>
          </h2>

          {
            inPress.length > 0 && (
              <>
                <h3 class="text-xl lg:text-2xl font-semibold text-neutral-700 mb-4">
                  In press
                </h3>
                <ul class="flex flex-col gap-6 mb-12">
                  {inPress.map((p) => (
                    <li class="bg-surface p-6 rounded-3xl shadow-md border border-primary/10 flex flex-col gap-2">
                      <h4 class="text-lg font-semibold text-neutral-700 max-w-none">
                        {p.title}
                      </h4>
                      <p
                        class="text-neutral-600 text-sm lg:text-base"
                        set:html={highlightSelf(p.authors)}
                      />
                      <p class="text-neutral-500 text-sm italic">
                        {p.journal}
                        {p.note ? `, ${p.note}` : ''}
                      </p>
                    </li>
                  ))}
                </ul>

                <h3 class="text-xl lg:text-2xl font-semibold text-neutral-700 mb-4">
                  In preparation
                </h3>
              </>
            )
          }
          <ul class="flex flex-col gap-6">
            {
              inPreparation.map((p) => (
                <li class="bg-surface p-6 rounded-3xl shadow-md border border-primary/10 flex flex-col gap-2">
                  <h4 class="text-lg font-semibold text-neutral-700 max-w-none">
                    {p.title}
                  </h4>
                  <p
                    class="text-neutral-600 text-sm lg:text-base"
                    set:html={highlightSelf(p.authors)}
                  />
                </li>
              ))
            }
          </ul>
          <p class="text-neutral-600 mt-6">{inPreparationNote}</p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 lg:py-24">
      <div class="container mx-auto px-4 sm:px-6">
        <div class="max-w-4xl mx-auto relative">
          <div
            class="absolute inset-0 bg-gradient-to-br from-primary/20 via-secondary/15 to-primary/10 rounded-3xl blur-sm"
            aria-hidden="true"
          >
          </div>

          <div
            class="relative border border-primary/20 rounded-3xl overflow-hidden shadow-xl"
          >
            <div
              class="flex flex-col gap-8 lg:gap-12 bg-gradient-to-br from-surface via-surface to-primary/5 px-6 sm:px-8 lg:px-12 xl:px-16 py-12 lg:py-20 text-center items-center"
            >
              <div class="flex flex-col gap-4">
                <h2
                  class="text-neutral-700 text-3xl sm:text-4xl lg:text-5xl font-medium mx-auto"
                >
                  More on the research
                </h2>
                <p
                  class="text-neutral-600 text-base sm:text-lg lg:text-xl max-w-2xl mx-auto"
                >
                  Non-peer-reviewed writing and media coverage are listed on the
                  outreach page, and the full academic record is on the CV page.
                </p>
              </div>

              <div class="flex flex-col sm:flex-row gap-4">
                <a
                  href="/experience"
                  class="px-8 py-4 rounded-xl transition-all duration-300 ease-out shadow-lg font-medium bg-primary text-white hover:shadow-2xl hover:scale-105 hover:bg-primary/80 hover:-translate-y-1"
                >
                  Research
                </a>
                <a
                  href="/outreach#media"
                  class="px-8 py-4 rounded-xl transition-all duration-300 ease-out shadow-lg font-medium bg-primary/90 text-white hover:shadow-2xl hover:scale-105 hover:bg-primary/80 hover:-translate-y-1"
                >
                  Writing &amp; media
                </a>
                {
                  CV_PDF_IS_CURRENT && (
                    <a
                      href={CV_PATH}
                      class="px-8 py-4 rounded-xl transition-all duration-300 ease-out shadow-lg font-medium bg-primary/90 text-white hover:shadow-2xl hover:scale-105 hover:bg-primary/80 hover:-translate-y-1"
                    >
                      Download CV
                    </a>
                  )
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
