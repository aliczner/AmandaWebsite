---
import Content from '../../layouts/Content.astro'
import Heading from '../../components/Heading.astro'
import Article from '../../components/Article.astro'
import Layout from '../../layouts/Layout.astro'
import Sidebar from '../../layouts/Sidebar.astro'
import Header from '../../components/Header.astro'
import ProjectCard from '../../components/ProjectCard.astro'
import Text from '../../components/Text.astro'
import { SEO } from 'astro-seo'
import '../../styles/main.scss'

const siteUrl = Astro.site?.toString() || 'https://amandaliczner.ca'
---

<SEO
  title="Current Research Projects - Dr. Amanda Liczner | Bumble Bee & Pollinator Ecology"
  description="Explore Dr. Amanda Liczner's active bumble bee research projects including pesticide impact studies, radio telemetry tracking, pathogen risk mapping, urban garden surveys, and soil temperature research across Canada."
  canonical={`${siteUrl}/current-work`}
  openGraph={{
    basic: {
      title: 'Current Research Projects - Dr. Amanda Liczner | Bumble Bee Ecology',
      type: 'website',
      image: `${siteUrl}/pictures/Project1A.JPG`,
      url: `${siteUrl}/current-work`,
    },
    optional: {
      description: 'Active bumble bee research: pesticide impacts, radio telemetry, pathogen risk mapping, urban gardens, and soil temperature studies across Canada.',
      siteName: 'Dr. Amanda Liczner - Freelance Ecological Consultant',
      locale: 'en_CA',
    },
    image: {
      url: `${siteUrl}/pictures/Project1A.JPG`,
      secureUrl: `${siteUrl}/pictures/Project1A.JPG`,
      alt: 'Bumble bee queen with radio telemetry tag - current research by Dr. Amanda Liczner',
      type: 'image/jpeg',
    }
  }}
  twitter={{
    card: 'summary_large_image',
    site: '@amandaliczner',
    creator: '@amandaliczner',
    title: 'Current Research Projects - Dr. Amanda Liczner',
    description: 'Active bumble bee research: pesticide impacts, radio telemetry, pathogen risk mapping, urban gardens & soil temperature studies.',
    image: `${siteUrl}/pictures/Project1A.JPG`,
    imageAlt: 'Bumble bee queen with radio telemetry tag - current research by Dr. Amanda Liczner',
  }}
  extend={{
    meta: [
      { name: 'keywords', content: 'bumble bee research Canada, pollinator ecology, pesticide impact bees, radio telemetry bees, pathogen spillover bumble bees, urban pollinator gardens, soil temperature bee emergence, conservation biology' },
      { name: 'author', content: 'Dr. Amanda Liczner' },
      { name: 'robots', content: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' },
    ]
  }}
/>

<Layout title="Current Research - Dr. Amanda Liczner | Bumble Bee & Pollinator Ecology">
  <Sidebar class="lg:hidden" />
  <Header />
  <Content>
    <section>
      <Article>
        <Heading
          slot="header"
          level={1}
          gradient
          class="inline-block py-1"
          text="Bumble Bee Research Projects - Pollinator Conservation & Ecology"
        />
        <Text class="text-xl"
          >Click on a project below to learn about my work
        </Text>
        <ProjectCard
          image="/pictures/Project1A.JPG"
          imageAlt="Bumble bee queen with radio telemetry tag - pesticide impact research on pollinator movement behavior"
          title="Impacts of environmental stressors on bumble bee queen movement"
          description="We are testing for possible impacts of pesticides on the movement of bumble bees. We are doing this with the help of tiny radio tags that track their movement!"
          buttonText="Learn More"
          buttonLink="/experience/env-stressors"
        />
        <ProjectCard
          image="/pictures/Project2A.jpg"
          imageAlt="Radio-tagged bumble bee queen for tracking movement patterns and habitat selection - Dr. Amanda Liczner conservation research"
          title="Learning their needs by tracking the bees"
          description="In this project we tagged spring bumble bee queens and late summer bumble bee queens to learn more about their movement behaviour, habitat selection, and about their nesting and overwintering habitat locations."
          buttonText="Learn More"
          buttonLink="/experience/bee-needs"
        />
        <ProjectCard
          image="/pictures/pathogen.jpg"
          imageAlt="Pathogen spillover risk mapping for wild bumble bees across Canada - conservation biology research"
          title="Pathogen risk to bumble bees across Canada"
          description="In this project we aim to identify regions in Canada where pathogen spillover from managed bees poses the highest risk to wild bumble bees, helping to prioritize conservation efforts."
          buttonText="Learn More"
          buttonLink="/experience/pathogen"
        />
        <ProjectCard
          image="/pictures/urbangardens.jpg"
          imageAlt="Native bee diversity study in urban pollinator gardens - Kelowna British Columbia habitat research"
          title="Urban bees response to backyard gardens"
          description="We looked at the diversity of native bees in bee-friendly urban gardens in Kelowna, British Columbia, and to explore how garden characteristics and surrounding urbanization influence bee populations."
          buttonText="Learn More"
          buttonLink="/experience/urban-gardens"
        />
        <ProjectCard
          image="/pictures/Project3A.jpg"
          imageAlt="Soil temperature monitoring equipment for predicting bumble bee queen emergence timing in spring - climate research Canada"
          title="Does soil temperature predict bumble bee queen emergence in spring?"
          description="To test the impact of soil temperature on queen bumble bee emergence timing, we surveyed for bumble bee queens, while simultaneously measuring soil temperature at different depths."
          buttonText="Learn More"
          buttonLink="/experience/soil-temperature"
        />
      </Article>
    </section>
  </Content>
</Layout>
