---
import Layout from '../../layouts/Layout.astro'
import Sidebar from '../../layouts/Sidebar.astro'
import Header from '../../components/Header.astro'
import PersonSchema from '../../components/PersonSchema.astro'
import { SEO } from 'astro-seo'
import {
  CV_PATH,
  CV_PDF_IS_CURRENT,
  SHOW_TEACHING_STATEMENT,
  METRICS,
} from '../../data/site'
import { positions } from '../../data/positions'
import {
  expertise,
  degrees,
  awards,
  grants,
  guestLectures,
  teachingAssistantships,
  mentorship,
  invitedTalks,
  conferenceTalks,
  professionalService,
  departmentalService,
  peerReview,
} from '../../data/academic'
import '../../styles/main.scss'

const siteUrl = Astro.site?.toString() || 'https://amandaliczner.ca'

const sections = [
  { id: 'expertise', label: 'Expertise' },
  { id: 'education', label: 'Education' },
  { id: 'appointments', label: 'Appointments' },
  { id: 'awards', label: 'Awards & funding' },
  { id: 'teaching', label: 'Teaching' },
  { id: 'mentorship', label: 'Mentorship' },
  { id: 'talks', label: 'Talks' },
  { id: 'service', label: 'Service' },
]
---

<SEO
  title="CV & Expertise | Dr. Amanda Liczner"
  description="Education, appointments, fellowships, teaching, mentorship, invited talks, service and peer review for behavioural ecologist Dr. Amanda Liczner."
  canonical={`${siteUrl}/skills-education`}
  openGraph={{
    basic: {
      title: 'CV & Expertise - Dr. Amanda Liczner',
      type: 'profile',
      image: `${siteUrl}/pictures/education.jpg`,
      url: `${siteUrl}/skills-education`,
    },
    optional: {
      description:
        'Research expertise, education, appointments, fellowships, teaching, mentorship, talks and service.',
      siteName: 'Dr. Amanda Liczner - Ecologist',
      locale: 'en_CA',
    },
    image: {
      url: `${siteUrl}/pictures/education.jpg`,
      secureUrl: `${siteUrl}/pictures/education.jpg`,
      alt: 'Dr. Amanda Liczner graduation photo',
      type: 'image/jpeg',
      width: 1650,
      height: 2475,
    },
  }}
  twitter={{
    card: 'summary_large_image',
    title: 'CV & Expertise - Dr. Amanda Liczner',
    description:
      'PhD in Biology. Animal behaviour and movement, spatial modelling, teaching and mentorship.',
    image: `${siteUrl}/pictures/education.jpg`,
    imageAlt: 'Dr. Amanda Liczner graduation photo',
  }}
  extend={{
    meta: [
      {
        name: 'keywords',
        content:
          'Amanda Liczner CV, behavioural ecology expertise, animal movement analysis, radio telemetry, spatial modelling, R programming, QGIS, conservation planning, NSERC postdoctoral fellowship, teaching experience ecology, mentorship, peer review',
      },
      { name: 'author', content: 'Dr. Amanda Liczner' },
      {
        name: 'robots',
        content: 'index, follow, max-image-preview:large, max-snippet:-1',
      },
      { property: 'profile:first_name', content: 'Amanda' },
      { property: 'profile:last_name', content: 'Liczner' },
      { name: 'geo.region', content: 'CA' },
    ],
    link: [
      {
        rel: 'alternate',
        hreflang: 'en-ca',
        href: `${siteUrl}/skills-education`,
      },
      { rel: 'alternate', hreflang: 'en', href: `${siteUrl}/skills-education` },
    ],
  }}
/>

<Layout title="CV & Expertise - Dr. Amanda Liczner">
  <Sidebar class="lg:hidden" />
  <Header />

  <PersonSchema />

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'CV & Expertise',
          item: `${siteUrl}/skills-education`,
        },
      ],
    })}
  />

  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Dr. Amanda Liczner',
      url: siteUrl,
      hasCredential: degrees.map((degree) => ({
        '@type': 'EducationalOccupationalCredential',
        credentialCategory: 'degree',
        name: degree.name,
        about: degree.thesis,
        recognizedBy: {
          '@type': 'EducationalOrganization',
          name: 'York University',
        },
      })),
    })}
  />

  <main>
    <!-- Hero -->
    <section class="relative py-20 lg:py-28 overflow-hidden">
      <div
        class="absolute inset-0 bg-gradient-to-br from-primary/5 via-secondary/5 to-primary/10"
      >
      </div>

      <div class="container relative px-4 sm:px-6">
        <div class="max-w-4xl mx-auto text-center">
          <nav aria-label="Breadcrumb" class="mb-6">
            <ol
              class="flex items-center justify-center gap-2 text-sm text-neutral-600"
            >
              <li>
                <a href="/" class="hover:text-primary transition-colors">Home</a
                >
              </li>
              <li aria-hidden="true">/</li>
              <li aria-current="page" class="text-primary font-medium">
                CV &amp; Expertise
              </li>
            </ol>
          </nav>

          <h1
            class="text-4xl sm:text-5xl lg:text-6xl font-medium text-neutral-700 mb-6"
          >
            <span
              class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent"
            >
              CV &amp; expertise
            </span>
          </h1>
          <p
            class="text-lg sm:text-xl lg:text-2xl text-neutral-600 max-w-3xl mx-auto leading-relaxed mb-8"
          >
            Research expertise, education, appointments, funding, teaching and
            service.
          </p>

          <nav aria-label="On this page">
            <ul class="flex flex-wrap justify-center gap-3">
              {
                sections.map((section) => (
                  <li>
                    <a
                      href={`#${section.id}`}
                      class="inline-block text-sm px-4 py-2 rounded-full bg-surface/80 border border-primary/20 text-neutral-700 hover:text-primary hover:border-primary transition-colors"
                    >
                      {section.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </div>
    </section>

    <!-- Expertise -->
    <section id="expertise" class="py-12 lg:py-20 relative">
      <div class="container px-4 sm:px-6">
        <div class="max-w-6xl mx-auto">
          <h2
            class="text-3xl sm:text-4xl lg:text-5xl font-medium text-center mb-12 lg:mb-16"
          >
            <span
              class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent"
            >
              Research expertise
            </span>
          </h2>

          <div class="grid sm:grid-cols-2 gap-6 lg:gap-8">
            {
              expertise.map((group) => (
                <div class="bg-surface p-6 lg:p-8 rounded-3xl shadow-lg hover:shadow-2xl transition-all duration-300 ease-out hover:scale-105 hover:-translate-y-2 border border-primary/10">
                  <h3 class="text-xl lg:text-2xl font-semibold mb-4 text-neutral-700">
                    {group.title}
                  </h3>
                  <ul class="space-y-2 text-neutral-600 list-disc pl-5">
                    {group.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Education -->
    <section
      id="education"
      class="py-12 lg:py-20 bg-primary/5"
    >
      <div class="container px-4 sm:px-6">
        <div class="max-w-6xl mx-auto">
          <h2
            class="text-3xl sm:text-4xl lg:text-5xl font-medium text-center mb-12 lg:mb-16"
          >
            <span
              class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent"
            >
              Education
            </span>
          </h2>

          <div class="grid md:grid-cols-3 gap-8 lg:gap-12 items-start">
            <div class="md:col-span-2 space-y-8">
              {
                degrees.map((degree) => (
                  <div class="bg-surface p-6 lg:p-8 rounded-3xl shadow-lg border border-primary/10">
                    <h3 class="text-2xl lg:text-3xl font-medium mb-4">
                      <span class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">
                        {degree.name}
                      </span>
                    </h3>
                    <p class="text-lg font-semibold text-neutral-700 mb-3">
                      {degree.institution}
                    </p>
                    <ul class="space-y-2 text-neutral-600">
                      <li class="font-semibold text-neutral-700">
                        {degree.years}
                      </li>
                      <li>
                        <strong>{degree.thesisLabel}:</strong> “{degree.thesis}”
                      </li>
                      <li>
                        <strong>Supervisor:</strong> {degree.supervisor}
                      </li>
                    </ul>
                  </div>
                ))
              }
            </div>

            <div
              class="md:col-span-1 flex items-center justify-center md:sticky md:top-24"
            >
              <div class="image-wrapper max-w-sm w-full">
                <img
                  src="/pictures/education.jpg"
                  alt="Dr. Amanda Liczner in graduation regalia"
                  loading="lazy"
                  width="800"
                  height="800"
                  class="w-full h-auto rounded-2xl"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Appointments -->
    <section id="appointments" class="py-12 lg:py-20">
      <div class="container px-4 sm:px-6">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-medium mb-10">
            <span
              class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent"
            >
              Appointments
            </span>
          </h2>

          <ol class="flex flex-col gap-4">
            {
              positions.map((position) => (
                <li class="bg-surface p-6 rounded-3xl shadow-md border border-primary/10">
                  <div class="flex flex-wrap items-baseline justify-between gap-2">
                    <h3 class="text-lg lg:text-xl font-semibold text-neutral-700 max-w-none">
                      {position.title}
                    </h3>
                    <p class="text-sm text-neutral-500 font-medium">
                      {position.dates}
                    </p>
                  </div>
                  <p class="text-base text-neutral-700 mt-1">
                    {position.organisation}
                    {position.unit ? `, ${position.unit}` : ''}
                  </p>
                  {position.supervisors && (
                    <p class="text-sm text-neutral-500 mt-1">
                      Supervised by {position.supervisors}
                    </p>
                  )}
                </li>
              ))
            }
          </ol>

          <p class="text-base text-neutral-600 mt-6">
            What each position involved is described on the <a
              href="/experience#appointments"
              class="link"
              >research page</a
            >.
          </p>
        </div>
      </div>
    </section>

    <!-- Awards & funding -->
    <section
      id="awards"
      class="py-12 lg:py-20 bg-primary/5"
    >
      <div class="container px-4 sm:px-6">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-medium mb-4">
            <span
              class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent"
            >
              Awards &amp; funding
            </span>
          </h2>
          <p class="text-lg text-neutral-600 mb-10">
            {METRICS.fellowshipTotal} in competitive fellowships and
            scholarships. Nominations and declined offers are labelled and are
            not counted towards that total.
          </p>

          <div class="overflow-x-auto bg-surface rounded-3xl shadow-lg border border-primary/10">
            <table class="w-full text-left border-collapse min-w-[40rem]">
              <thead>
                <tr class="border-b border-neutral-200">
                  <th class="p-4 text-sm uppercase tracking-wide text-neutral-500"
                    >Years</th
                  >
                  <th class="p-4 text-sm uppercase tracking-wide text-neutral-500"
                    >Award</th
                  >
                  <th class="p-4 text-sm uppercase tracking-wide text-neutral-500"
                    >Value</th
                  >
                </tr>
              </thead>
              <tbody>
                {
                  awards.map((award) => (
                    <tr class="border-b border-neutral-100 last:border-0 align-top">
                      <td class="p-4 text-sm text-neutral-500 whitespace-nowrap">
                        {award.years}
                      </td>
                      <td class="p-4">
                        <span
                          class:list={[
                            'text-neutral-700',
                            award.major ? 'font-semibold' : '',
                          ]}
                        >
                          {award.name}
                        </span>
                        <span class="block text-sm text-neutral-500">
                          {award.organisation}
                        </span>
                        {award.note && (
                          <span class="block text-sm text-neutral-500 italic">
                            {award.note}
                          </span>
                        )}
                      </td>
                      <td class="p-4 text-neutral-700 whitespace-nowrap">
                        {award.status === 'nominated'
                          ? 'Nominated'
                          : award.status === 'declined'
                            ? 'Declined'
                            : (award.value ?? '')}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <h3
            class="text-2xl lg:text-3xl font-medium mt-12 mb-6 text-neutral-700"
          >
            Research grants
          </h3>
          <ul class="flex flex-col gap-4">
            {
              grants.map((grant) => (
                <li class="bg-surface p-6 rounded-3xl shadow-md border border-primary/10">
                  <div class="flex flex-wrap items-baseline justify-between gap-2">
                    <h4 class="text-lg font-semibold text-neutral-700 max-w-none">
                      {grant.name}
                    </h4>
                    <p class="text-sm text-neutral-500 font-medium">
                      {grant.years}
                    </p>
                  </div>
                  <p class="text-neutral-600 mt-1">{grant.funder}</p>
                  <p class="text-neutral-700 font-medium mt-1">{grant.value}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- Teaching -->
    <section id="teaching" class="py-12 lg:py-20">
      <div class="container px-4 sm:px-6">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-medium mb-10">
            <span
              class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent"
            >
              Teaching
            </span>
          </h2>

          {
            SHOW_TEACHING_STATEMENT && (
              <div class="bg-surface p-6 lg:p-8 rounded-3xl shadow-lg border border-primary/10 mb-10">
                <h3 class="text-xl lg:text-2xl font-semibold text-neutral-700 mb-3">
                  How I teach
                </h3>
                <p class="text-neutral-600 leading-relaxed mb-3">
                  I view teaching as an opportunity to equip students with the
                  intellectual versatility required to tackle complex,
                  multi-scale environmental problems. Environmental challenges
                  ask students to integrate empirical field ecology with
                  quantitative reasoning, spatial analysis, and
                  cross-disciplinary thinking.
                </p>
                <p class="text-neutral-600 leading-relaxed">
                  By embedding the principles of inclusive learning and
                  Universal Design for Learning into my teaching, and using
                  experiential learning wherever possible, I aim to give
                  students the knowledge and skills to become researchers
                  themselves. I am keen to involve undergraduates directly in my
                  research, where the learning is hands-on.
                </p>
              </div>
            )
          }

          <h3 class="text-2xl lg:text-3xl font-medium mb-6 text-neutral-700">
            Guest lectures
          </h3>
          <ul class="flex flex-col gap-4 mb-12">
            {
              guestLectures.map((lecture) => (
                <li class="bg-surface p-6 rounded-3xl shadow-md border border-primary/10">
                  <div class="flex flex-wrap items-baseline justify-between gap-2">
                    <h4 class="text-lg font-semibold text-neutral-700 max-w-none">
                      {lecture.course}
                    </h4>
                    <p class="text-sm text-neutral-500 font-medium">
                      {lecture.year}
                    </p>
                  </div>
                  <p class="text-neutral-600 mt-1">
                    {lecture.institution}, {lecture.students} students
                  </p>
                  <p class="text-neutral-600 mt-1 italic">{lecture.topic}</p>
                </li>
              ))
            }
          </ul>

          <h3 class="text-2xl lg:text-3xl font-medium mb-6 text-neutral-700">
            Teaching assistantships
          </h3>
          <div
            class="bg-surface p-6 lg:p-8 rounded-3xl shadow-lg border border-primary/10"
          >
            <p class="text-neutral-600 leading-relaxed">
              {teachingAssistantships.summary}
            </p>
            <details class="mt-4">
              <summary
                class="cursor-pointer text-primary hover:text-primary/80 font-medium"
                >All appointments</summary
              >
              <ul class="mt-4 space-y-2 text-sm text-neutral-600 list-disc pl-5">
                {
                  teachingAssistantships.detail.map((item) => <li>{item}</li>)
                }
              </ul>
            </details>
          </div>
        </div>
      </div>
    </section>

    <!-- Mentorship -->
    <section
      id="mentorship"
      class="py-12 lg:py-20 bg-primary/5"
    >
      <div class="container px-4 sm:px-6">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-medium mb-10">
            <span
              class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent"
            >
              Mentorship &amp; supervision
            </span>
          </h2>

          <ul class="flex flex-col gap-4">
            {
              mentorship.map((item) => (
                <li class="bg-surface p-6 lg:p-8 rounded-3xl shadow-md border border-primary/10">
                  <div class="flex flex-wrap items-baseline justify-between gap-2">
                    <h3 class="text-lg lg:text-xl font-semibold text-neutral-700 max-w-none">
                      {item.role}
                    </h3>
                    <p class="text-sm text-neutral-500 font-medium">
                      {item.years}
                    </p>
                  </div>
                  <p class="text-base text-neutral-700 mt-1">
                    {item.organisation}
                  </p>
                  <p class="text-neutral-600 leading-relaxed mt-3">
                    {item.detail}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- Talks -->
    <section id="talks" class="py-12 lg:py-20">
      <div class="container px-4 sm:px-6">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-medium mb-4">
            <span
              class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent"
            >
              Talks
            </span>
          </h2>
          <p class="text-lg text-neutral-600 mb-10">
            {METRICS.invitedTalks} invited presentations and {
              METRICS.conferenceTalks
            } conference presentations.
          </p>

          <h3 class="text-2xl lg:text-3xl font-medium mb-6 text-neutral-700">
            Invited presentations
          </h3>
          <ol
            class="flex flex-col gap-4 bg-surface p-6 lg:p-8 rounded-3xl shadow-lg border border-primary/10"
          >
            {
              invitedTalks.map((talk) => (
                <li class="text-neutral-600 text-sm lg:text-base leading-relaxed">
                  {talk}
                </li>
              ))
            }
          </ol>

          <div
            class="bg-surface p-6 lg:p-8 rounded-3xl shadow-lg border border-primary/10 mt-8"
          >
            <details>
              <summary
                class="cursor-pointer text-primary hover:text-primary/80 font-medium text-lg"
              >
                All {METRICS.conferenceTalks} conference presentations
              </summary>
              <ol class="mt-4 flex flex-col gap-3">
                {
                  conferenceTalks.map((talk) => (
                    <li class="text-neutral-600 text-sm leading-relaxed">
                      {talk}
                    </li>
                  ))
                }
              </ol>
            </details>
          </div>
        </div>
      </div>
    </section>

    <!-- Service -->
    <section
      id="service"
      class="py-12 lg:py-20 bg-primary/5"
    >
      <div class="container px-4 sm:px-6">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-medium mb-10">
            <span
              class="bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent"
            >
              Service &amp; peer review
            </span>
          </h2>

          <h3 class="text-2xl lg:text-3xl font-medium mb-6 text-neutral-700">
            Professional service
          </h3>
          <ul class="flex flex-col gap-4 mb-12">
            {
              professionalService.map((item) => (
                <li class="bg-surface p-6 rounded-3xl shadow-md border border-primary/10">
                  <div class="flex flex-wrap items-baseline justify-between gap-2">
                    <h4 class="text-lg font-semibold text-neutral-700 max-w-none">
                      {item.role}
                    </h4>
                    <p class="text-sm text-neutral-500 font-medium">
                      {item.years}
                    </p>
                  </div>
                  <p class="text-neutral-600 mt-1">{item.organisation}</p>
                  {item.detail && (
                    <p class="text-neutral-600 text-sm mt-2 leading-relaxed">
                      {item.detail}
                    </p>
                  )}
                </li>
              ))
            }
          </ul>

          <h3 class="text-2xl lg:text-3xl font-medium mb-6 text-neutral-700">
            Departmental &amp; institutional service
          </h3>
          <ul class="flex flex-col gap-4 mb-12">
            {
              departmentalService.map((item) => (
                <li class="bg-surface p-6 rounded-3xl shadow-md border border-primary/10">
                  <div class="flex flex-wrap items-baseline justify-between gap-2">
                    <h4 class="text-lg font-semibold text-neutral-700 max-w-none">
                      {item.role}
                    </h4>
                    <p class="text-sm text-neutral-500 font-medium">
                      {item.years}
                    </p>
                  </div>
                  <p class="text-neutral-600 mt-1">{item.organisation}</p>
                  {item.detail && (
                    <p class="text-neutral-600 text-sm mt-2 leading-relaxed">
                      {item.detail}
                    </p>
                  )}
                </li>
              ))
            }
          </ul>

          <h3 class="text-2xl lg:text-3xl font-medium mb-6 text-neutral-700">
            Peer review
          </h3>
          <div
            class="bg-surface p-6 lg:p-8 rounded-3xl shadow-lg border border-primary/10"
          >
            <p class="text-neutral-600 mb-4">
              {METRICS.reviews} reviews for {METRICS.journalsReviewedFor}
              journals.
            </p>
            <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-2 text-neutral-600">
              {
                peerReview.map((entry) => (
                  <li class="flex justify-between gap-4 border-b border-neutral-100 py-1">
                    <span>{entry.journal}</span>
                    <span class="text-neutral-400 tabular-nums">
                      {entry.count}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- CV download -->
    <section id="cv-pdf" class="py-16 lg:py-24">
      <div class="container mx-auto px-4 sm:px-6">
        <div class="max-w-4xl mx-auto relative">
          <div
            class="absolute inset-0 bg-gradient-to-br from-primary/20 via-secondary/15 to-primary/10 rounded-3xl blur-sm"
            aria-hidden="true"
          >
          </div>

          <div
