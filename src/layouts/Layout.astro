---
interface Props {
  title: string
}
import Footer from '../components/Footer.astro'
const { title } = Astro.props
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-R3N9KDPW8W"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-R3N9KDPW8W');
    </script>
  </head>
  <body>
    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  html {
    @apply scroll-smooth;
    scroll-padding-top: 80px;
  }

  main {
    @apply min-h-dvh;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    @apply font-medium text-balance max-w-[25ch];
  }

  p {
    @apply font-light text-pretty max-w-[65ch];
  }

  /* Improved focus states for accessibility */
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid rgb(var(--ac-primary));
    outline-offset: 2px;
  }
</style>
